# ==============================================================================
# MMC Career Readiness Grant™ 2027–28 — Server Environment Configuration
# Copy this file to .env and fill in your actual production values.
# NEVER commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Secret key used to sign/verify admin sessions (min 32 characters)
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars

# ------------------------------------------------------------------------------
# 2. Admin Security
# Initial default password is set to Mymentorcircle@2026.
# To change or rotate the password, generate a secure scrypt hash using:
#   node -e "const { hashPassword } = require('./src/auth'); console.log(hashPassword('YourNewPasswordHere'));"
# and paste the resulting hash string below:
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# 3. Google Sheets Integration (Choose ONE of the two methods below)
# ------------------------------------------------------------------------------
# Method A: Google Apps Script Webhook (Recommended: Simple, zero-key setup)
# Deploy a 10-line Apps Script in your Google Sheet as a Web App, and paste the URL here:
GOOGLE_SHEETS_WEBHOOK_URL=

# Method B: Google Cloud Service Account (Google Sheets API v4)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Leads

# ------------------------------------------------------------------------------
# 4. CRM Integration (Awaiting CRM choice & details from user)
# ------------------------------------------------------------------------------
CRM_PROVIDER=
CRM_API_URL=
CRM_API_KEY=

# ------------------------------------------------------------------------------
# 5. Meta Ads Marketing API (Optional for Ads Manager Account Metrics)
# ------------------------------------------------------------------------------
META_APP_ID=
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 6. Compliance & Data Retention
# ------------------------------------------------------------------------------
DATA_RETENTION_DAYS=730
PRIVACY_POLICY_URL=https://www.mymentorcircle.com/legal/privacy
